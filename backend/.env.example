# MongoDB Configuration
# Replace placeholders with your own connection string. Do not commit backend/.env.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/food_ordering_db?retryWrites=true&w=majority
MONGO_DB_NAME=food_ordering_db

# Cassandra Configuration
CASS_CONTACT_POINTS=127.0.0.1
CASS_PORT=9042
CASS_KEYSPACE=food_ordering
CASS_USERNAME=
CASS_PASSWORD=
